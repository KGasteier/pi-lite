    "bereich":{"enum":["Projekte","Ergebnisse","Skills","Verlaeufe"]},
    "sync_datei":{"type":"object","properties":{"pfad":{"type":"string"},"bytes":{"type":"integer","minimum":0},"status":{"enum":["neu","geaendert","unveraendert"]}},"required":["pfad","bytes","status"]},
    "belegung_inhalt":{"type":"object","properties":{"v":{"const":1},"typ":{"const":"belegung"},"slot":{"$ref":"#/$defs/slot"},"checkin_id":{"$ref":"#/$defs/id"},"epoche":{"$ref":"#/$defs/epoche"},"person":{"type":"string","minLength":1,"maxLength":120},"rolle":{"$ref":"#/$defs/rolle"},"gueltig_bis":{"$ref":"#/$defs/sekunden"},"geraete":{"type":"array","minItems":1,"maxItems":20,"items":{"type":"object","properties":{"geraet_id":{"$ref":"#/$defs/id"},"pubkey":{"$ref":"#/$defs/pubkey"},"name":{"type":"string","maxLength":120},"art":{"enum":["desktop","handy"]}},"required":["geraet_id","pubkey","name","art"]}},"signatur":{"$ref":"#/$defs/signatur"}},"required":["v","typ","slot","checkin_id","epoche","person","rolle","geraete","gueltig_bis"]},
    "freigabe_inhalt":{"type":"object","properties":{"v":{"const":1},"typ":{"const":"freigabe"},"slot":{"$ref":"#/$defs/slot"},"checkin_id":{"$ref":"#/$defs/id"},"epoche":{"$ref":"#/$defs/epoche"},"signatur":{"$ref":"#/$defs/signatur"}},"required":["v","typ","slot","checkin_id","epoche"]},
    "geraeteausweis_inhalt":{"type":"object","properties":{"v":{"const":1},"typ":{"const":"geraeteausweis"},"pid":{"type":"string"},"person":{"type":"string"},"rolle":{"$ref":"#/$defs/rolle"},"net_pubkey":{"$ref":"#/$defs/net_pubkey"},"geraet_pubkey":{"$ref":"#/$defs/pubkey"},"iat":{"$ref":"#/$defs/sekunden"},"exp":{"$ref":"#/$defs/sekunden"},"signatur":{"$ref":"#/$defs/signatur"}},"required":["v","typ","pid","person","rolle","net_pubkey","geraet_pubkey","iat","exp"]},
    "slot": {"type": "string", "pattern": "^account(0[1-9]|10)$"},
    "session": {"type": "object", "properties": {"protokoll": {"const": 1}, "typ": {"const": "session_zustand"}, "session_id": {"type": "string"}, "zustand": {"enum": ["ruht", "arbeitet", "wartet", "fertig", "bereit", "fehler"]}, "seit": {"type": "integer"}, "titel": {"type": "string"}, "workspace": {"type": "string"}}, "required": ["protokoll", "typ", "session_id", "zustand", "seit", "titel", "workspace"]}
  }
}
