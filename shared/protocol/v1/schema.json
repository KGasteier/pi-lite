{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cocopi.invalid/protocol/v1/schema.json",
  "title": "cocopi Protokoll v1",
  "type": "object",
  "required": ["protokoll", "typ"],
  "properties": {"protokoll": {"const": 1}, "typ": {"type": "string"}},
  "oneOf": [
    {"properties":{"typ":{"const":"challenge"},"challenge_id":{"type":"string"},"nonce":{"type":"string"},"gueltig_bis":{"type":"integer"}},"required":["challenge_id","nonce","gueltig_bis"],"not":{"required":["slot"]}},
    {"properties":{"typ":{"const":"empfang_challenge"},"checkin_id":{"$ref":"#/$defs/id"}},"required":["checkin_id"]},
    {"properties":{"typ":{"const":"empfang_willkommen"},"slots_gesamt":{"type":"integer","minimum":1},"slots_frei":{"type":"integer","minimum":0},"warteschlange":{"type":"integer","minimum":0},"oidc":{"type":"object","required":["issuer","client_id","scopes"],"properties":{"issuer":{"type":"string"},"client_id":{"type":"string"},"scopes":{"type":"array","items":{"type":"string"}}}},"empfang_pubkey":{"$ref":"#/$defs/pubkey"},"vertrag":{"const":"cocopi-pool-v1"}},"required":["slots_gesamt","slots_frei","warteschlange","oidc","empfang_pubkey","vertrag"]},
    {"properties":{"typ":{"const":"checkin"},"nachweis":{"oneOf":[{"type":"object","properties":{"art":{"const":"oidc"},"id_token":{"type":"string"},"nonce":{"type":"string"}},"required":["art","id_token","nonce"]},{"type":"object","properties":{"art":{"const":"einladung"},"code":{"type":"string"}},"required":["art","code"]}]},"geraet":{"type":"object","properties":{"pubkey":{"$ref":"#/$defs/pubkey"},"name":{"type":"string"},"art":{"const":"desktop"}},"required":["pubkey","name","art"]},"net_pubkey":{"$ref":"#/$defs/net_pubkey"},"archiv_pubkey":{"$ref":"#/$defs/pubkey"}},"required":["nachweis","geraet"]},
    {"properties":{"typ":{"const":"eingecheckt"},"checkin_id":{"$ref":"#/$defs/id"},"slot":{"$ref":"#/$defs/slot"},"hub_pfad":{"type":"string","pattern":"^/slot/account(0[1-9]|10)$"},"person":{"type":"string"},"rolle":{"$ref":"#/$defs/rolle"},"belegung":{"$ref":"#/$defs/belegung"},"geraeteausweis":{"$ref":"#/$defs/geraeteausweis"},"gueltig_bis":{"$ref":"#/$defs/sekunden"}},"required":["checkin_id","slot","hub_pfad","person","rolle","belegung","geraeteausweis","gueltig_bis"]},
    {"properties":{"typ":{"const":"warteschlange"},"warte_id":{"$ref":"#/$defs/id"},"platz":{"type":"integer","minimum":1},"geschaetzt_min":{"type":"integer","minimum":0}},"required":["warte_id","platz"]},
    {"properties":{"typ":{"const":"checkout"},"checkin_id":{"$ref":"#/$defs/id"}},"required":["checkin_id"]},
    {"properties":{"typ":{"const":"checkout_bereit"},"checkout_id":{"$ref":"#/$defs/id"},"archiv_id":{"$ref":"#/$defs/id"},"sha256":{"$ref":"#/$defs/sha256"},"bytes":{"type":"integer","minimum":0}},"required":["checkout_id"]},
    {"properties":{"typ":{"const":"erhalten"},"sha256":{"$ref":"#/$defs/sha256"}},"required":["sha256"]},
    {"properties":{"typ":{"const":"ausgecheckt"}}},
    {"properties":{"typ":{"const":"empfang_status"},"belegung":{"type":"array","items":{"type":"object","properties":{"slot":{"$ref":"#/$defs/slot"},"person":{"type":"string"},"seit":{"type":"integer"},"zustand":{"type":"string"}},"required":["slot","person","seit","zustand"]}}},"required":["belegung"]},
    {"properties":{"typ":{"const":"belegung"},"belegung":{"$ref":"#/$defs/belegung"}},"required":["belegung"]},
    {"properties":{"typ":{"const":"freigabe"},"freigabe":{"$ref":"#/$defs/freigabe"}},"required":["freigabe"]},
    {"properties":{"typ":{"enum":["belegung_aktiv","belegung_ok","freigegeben"]},"slot":{"$ref":"#/$defs/slot"},"checkin_id":{"$ref":"#/$defs/id"}},"required":["slot","checkin_id"]},
    {"properties":{"typ":{"const":"senden"},"text":{"type":"string","minLength":1,"maxLength":32000},"von":{"$ref":"#/$defs/von"}},"required":["text"]},
    {"properties":{"typ":{"const":"sync_leer"},"leer":{"type":"boolean"}},"required":["leer"]},
    {"properties":{"typ":{"const":"sync_dienst"},"auftrag":{"$ref":"#/$defs/sync_auftrag"}},"required":["auftrag"]},
    {"properties":{"typ":{"const":"sync_hoch_ok"},"bereich":{"$ref":"#/$defs/bereich"},"name":{"type":"string"},"dateien":{"type":"integer","minimum":0},"bytes":{"type":"integer","minimum":0},"manifest_sha256":{"$ref":"#/$defs/sha256"}},"required":["bereich","name","dateien","bytes","manifest_sha256"]},
    {"properties":{"typ":{"const":"sync_vorschau"},"persoenlich":{"type":"array","items":{"$ref":"#/$defs/sync_datei"}},"gross":{"type":"array","items":{"$ref":"#/$defs/sync_datei"}},"fluechtig":{"type":"object","properties":{"bytes":{"type":"integer","minimum":0},"dateien":{"type":"integer","minimum":0},"beispiele":{"type":"array","maxItems":20,"items":{"type":"string"}}},"required":["bytes","dateien","beispiele"]}},"required":["persoenlich","fluechtig","gross"]},
    {"properties":{"typ":{"const":"archiv_bereit"},"archiv_id":{"$ref":"#/$defs/id"},"sha256":{"$ref":"#/$defs/sha256"},"bytes":{"type":"integer","minimum":0}},"required":["archiv_id","sha256","bytes"]},
    {"properties": {"typ": {"const": "hallo"}, "app": {"type": "string"}}, "required": ["app"]},
    {"properties": {"typ": {"const": "willkommen"}, "min_client": {"const": 1}, "slot": {"$ref": "#/$defs/slot"}, "person": {"type": "string"}, "hub_version": {"type": "string"}, "vertrag": {"const": "cocopi-slots-v1"}}, "required": ["min_client", "slot", "person", "hub_version", "vertrag"]},
    {"properties": {"typ": {"const": "sessions_liste"}, "sessions": {"type": "array", "items": {"$ref": "#/$defs/session"}}}, "required": ["sessions"]},
    {"$ref": "#/$defs/session"},
    {"properties": {"typ": {"const": "fehler"}, "code": {"type": "string"}, "was": {"type": "string", "minLength": 1}, "tun": {"type": "string", "minLength": 1}}, "required": ["code", "was", "tun"]},
    {"properties": {"typ": {"const": "puls"}, "t": {"type": "integer"}}, "required": ["t"]},
    {"properties": {"typ": {"const": "einloesen"}, "art": {"enum": ["e", "k", "b"]}, "code": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{4}(-[0-9A-HJKMNP-TV-Z]{4}){3}$"}, "slot": {"$ref": "#/$defs/slot"}, "pubkey": {"type": "string"}, "geraetename": {"type": "string"}, "geraeteart": {"enum": ["desktop", "handy"]}}, "required": ["art", "code"]},
    {"properties": {"typ": {"const": "einladung_eingeloest"}, "slot": {"$ref": "#/$defs/slot"}, "person": {"type": "string"}, "geraet_id": {"type": "string"}}, "required": ["slot", "person", "geraet_id"]},
    {"properties": {"typ": {"const": "challenge"}, "challenge_id": {"type": "string"}, "nonce": {"type": "string"}, "slot": {"$ref": "#/$defs/slot"}, "gueltig_bis": {"type": "integer"}}, "required": ["challenge_id", "nonce", "slot", "gueltig_bis"]},
    {"properties": {"typ": {"const": "anmelden"}, "challenge_id": {"type": "string"}, "signatur": {"type": "string"}}, "required": ["challenge_id", "signatur"]},
    {"properties": {"typ": {"const": "angemeldet"}, "zugangstoken": {"type": "string"}, "gueltig_bis": {"type": "integer"}, "geraet_id": {"type": "string"}, "slot": {"$ref": "#/$defs/slot"}, "person": {"type": "string"}}, "required": ["zugangstoken", "gueltig_bis", "geraet_id", "slot", "person"]},
    {"properties": {"typ": {"const": "koppeln_start"}, "code": {"type": "string"}, "url": {"type": "string"}, "gueltig_bis": {"type": "integer"}}, "required": ["code", "url", "gueltig_bis"]},
    {"properties": {"typ": {"const": "koppeln_wartet"}, "anfrage_id": {"type": "string"}, "geraetename": {"type": "string"}}, "required": ["anfrage_id"]},
    {"properties": {"typ": {"const": "koppeln_bestaetigen"}, "anfrage_id": {"type": "string"}, "erlauben": {"type": "boolean"}}, "required": ["anfrage_id", "erlauben"]},
    {"properties": {"typ": {"const": "koppeln_bestaetigt"}, "erlauben": {"type": "boolean"}, "geraet_id": {"type": "string"}}, "required": ["erlauben"]},
    {"properties": {"typ": {"const": "geraete_liste"}, "geraete": {"type": "array", "items": {"type": "object", "required": ["geraet_id", "slot", "art", "geraetename", "widerrufen"], "properties": {"geraet_id": {"type": "string"}, "slot": {"$ref": "#/$defs/slot"}, "art": {"enum": ["desktop", "handy"]}, "geraetename": {"type": "string"}, "widerrufen": {"type": "boolean"}}}}}, "required": ["geraete"]},
    {"properties": {"typ": {"const": "widerruf"}, "geraet_id": {"type": "string"}}, "required": ["geraet_id"]},
    {"properties": {"typ": {"const": "session_ereignis"}, "session_id": {"type": "string"}, "pi_event": {"type": "object"}, "von": {"$ref":"#/$defs/von"}}, "required": ["session_id", "pi_event"]}
  ],
  "$defs": {
    "belegung":{"oneOf":[{"allOf":[{"$ref":"#/$defs/belegung_inhalt"},{"required":["signatur"]}]},{"type":"object","properties":{"inhalt":{"$ref":"#/$defs/belegung_inhalt"},"signatur":{"$ref":"#/$defs/signatur"}},"required":["inhalt","signatur"],"additionalProperties":false}]},
    "freigabe":{"oneOf":[{"allOf":[{"$ref":"#/$defs/freigabe_inhalt"},{"required":["signatur"]}]},{"type":"object","properties":{"inhalt":{"$ref":"#/$defs/freigabe_inhalt"},"signatur":{"$ref":"#/$defs/signatur"}},"required":["inhalt","signatur"],"additionalProperties":false}]},
    "geraeteausweis":{"oneOf":[{"allOf":[{"$ref":"#/$defs/geraeteausweis_inhalt"},{"required":["signatur"]}]},{"type":"object","properties":{"inhalt":{"$ref":"#/$defs/geraeteausweis_inhalt"},"signatur":{"$ref":"#/$defs/signatur"}},"required":["inhalt","signatur"],"additionalProperties":false}]},
    "sync_auftrag":{"type":"object","properties":{"v":{"const":1},"typ":{"const":"sync_dienst"},"aktion":{"enum":["archiv","holen","leer_pruefen"]},"slot":{"$ref":"#/$defs/slot"},"checkin_id":{"$ref":"#/$defs/id"},"iat":{"type":"integer"},"nonce":{"$ref":"#/$defs/pubkey"},"archiv_id":{"$ref":"#/$defs/id"},"signatur":{"$ref":"#/$defs/signatur"}},"required":["v","typ","aktion","slot","checkin_id","iat","nonce","signatur"],"if":{"properties":{"aktion":{"const":"holen"}}},"then":{"required":["archiv_id"]}},
    "id":{"type":"string","pattern":"^[A-Za-z0-9_-]{1,128}$"},
    "pubkey":{"type":"string","pattern":"^[A-Za-z0-9_-]{43}$"},
