# I1-Userdienst absichtlich deaktiviert. I2 verwendet ausschließlich die
# System-Unit systemd/cocopi-hub@.service (User=%i, Slice, neues Env).
[Unit]
Description=VERALTET - cocopi I1 User-Hub nicht starten
ConditionPathExists=/nicht-vorhanden/cocopi-i1-gesperrt

[Service]
Type=oneshot
ExecStart=/usr/bin/false
