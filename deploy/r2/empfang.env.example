# Empfang · Beispiel ohne Geheimnisse, systemd-EnvironmentFile, kein Shell-source.
EMPFANG_PORT=8800
EMPFANG_STATE=/var/lib/cocopi-empfang
EMPFANG_EPOCHEN_DIR=/var/lib/cocopi/slots
# Zunächst account01,account02; nach Abnahme account01..account10.
EMPFANG_SLOTS=account01,account02
EMPFANG_ORIGIN=https://cocopi.example.invalid
EMPFANG_OIDC_ISSUER=https://auth.example.invalid/application/o/cocopi/
EMPFANG_OIDC_CLIENT_ID=BITTE_EINTRAGEN
EMPFANG_SLOTCTL=/usr/local/lib/cocopi-r2/slotctl-empfang
# N8: Aktiv-Signal kommt vom Desktop/Mobil-Client, keine neue Servervariable.
# Nur !verbunden und >8 h seit letztem Signal oder nächstes Tagesende >= Check-in.
EMPFANG_TAGESENDE=23:30
DO_NOT_TRACK=1
# Signier- und HMAC-Schlüssel erzeugt S7 privat im STATE (kein manuelles Duplikat).
# 12-h-Ausweis, max. 72-h-Abholfach und 7-Tage-Logfrist sind S7-Vertrag.
# N7: letzte leeren-JSON-Zeile auswerten, danach kein Live-pruefen.
# N9: signiertes Seminarverzeichnis nutzt den vorhandenen Empfangsschlüssel.
# N10: feste Grenze 384 MiB Klartext (402653184 Bytes) für Zwangsarchive;
# darüber erzwingen_blockiert, Backoff 5/15/60 min, Daten bleiben bis manuell.
# Dafür KEINE zusätzliche EMPFANG_*-Variable; nicht mit 2-GiB-Sync-Limit verwechseln.
# N7–N10 vor Betrieb separat nachweisen; diese Vorlage aktiviert keine Funktion.
